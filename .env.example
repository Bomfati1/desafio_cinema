# ══════════════════════════════════════════════════════════════
# Cinema API — Variáveis de Ambiente para Produção
# ══════════════════════════════════════════════════════════════
#
# 🚀 Como usar:
#   1. Copie este arquivo para .env na raiz do projeto
#   2. Preencha com seus valores reais de produção
#   3. O .env NUNCA deve ser commitado (já está no .gitignore)
#
# 📌 No .NET, variáveis de ambiente com "__" viram chaves aninhadas:
#   ConnectionStrings__DefaultConnection → appsettings "ConnectionStrings:DefaultConnection"
#   Jwt__Key                           → appsettings "Jwt:Key"
#
# 💻 Para desenvolvimento local, use User Secrets em vez de .env:
#   dotnet user-secrets set "Jwt:Key" "sua-chave-aqui"
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;..."
#
# 🌐 Em produção, defina essas variáveis no seu servidor/hospedagem:
#   - Azure App Service → Application Settings
#   - Railway / Render / Fly.io → Environment Variables no dashboard
#   - IIS → web.config ou Application Pool settings
#   - Docker → docker run -e ou docker-compose.yml
#   - Servidor Linux → /etc/environment ou systemd service file

# ── ASP.NET Core ──────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://0.0.0.0:8080  # porta em produção

# ── Banco de Dados (PostgreSQL) ──────────────────────────
# ⚠️ Use SEMPRE um usuário limitado e senha forte em produção
ConnectionStrings__DefaultConnection=Host=SEU_HOST;Port=5432;Database=cinema_db;Username=SEU_USUARIO;Password=SUA_SENHA_FORTE

# ── JWT (JSON Web Token) ─────────────────────────────────
# ⚠️ Gere uma chave forte com no mínimo 32 caracteres
#    Exemplo para gerar (PowerShell):
#    [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
Jwt__Key=SUA_CHAVE_JWT_MINIMO_32_CARACTERES_AQUI
Jwt__Issuer=CinemaApi
Jwt__Audience=CinemaApp
Jwt__ExpireMinutes=60
Jwt__RefreshExpireDays=7

# ── CORS (Opcional — defina em produção se necessário) ────
# Se precisar permitir origens específicas, configure no appsettings.Production.json
